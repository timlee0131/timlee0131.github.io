---
layout: default
---
<style>
  .cv-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .cv-header-row .post-title {
    margin-bottom: 0;
  }
  .cv-downloads {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .cv-dl-btn {
    display: inline-block;
    color: var(--global-text-color);
    border: 1px solid var(--global-text-color);
    border-radius: 0.25rem;
    padding: 0.4rem 1rem;
    font-size: 0.95rem;
  }
  .cv-dl-btn:hover {
    color: var(--global-theme-color);
    border-color: var(--global-theme-color);
    text-decoration: none;
  }
  .cv-dl-btn i {
    margin-right: 0.45rem;
  }
</style>

<div class="post">
  <header class="post-header">
    <div class="cv-header-row">
      <h1 class="post-title">{{ page.title }}</h1>

      <div class="cv-downloads">
        {% if page.cv_pdf %}
          {% assign cv_pdf_rel = page.cv_pdf | remove_first: '/' %}
          {% capture cv_pdf_exists %}{% file_exists {{ cv_pdf_rel }} %}{% endcapture %}
          {% if page.cv_pdf contains '://' or cv_pdf_exists contains 'true' %}
            <a
              class="cv-dl-btn"
              href="{% if page.cv_pdf contains '://' %}{{ page.cv_pdf }}{% else %}{{ page.cv_pdf | relative_url }}{% endif %}"
              target="_blank"
              rel="noopener noreferrer"
            >
              <i class="fa-solid fa-file-pdf"></i>Download CV (PDF)
            </a>
          {% endif %}
        {% endif %}
        {% if page.cv_docx %}
          {% assign cv_docx_rel = page.cv_docx | remove_first: '/' %}
          {% capture cv_docx_exists %}{% file_exists {{ cv_docx_rel }} %}{% endcapture %}
          {% if page.cv_docx contains '://' or cv_docx_exists contains 'true' %}
            <a class="cv-dl-btn" href="{% if page.cv_docx contains '://' %}{{ page.cv_docx }}{% else %}{{ page.cv_docx | relative_url }}{% endif %}">
              <i class="fa-solid fa-file-word"></i>Download CV (Word)
            </a>
          {% endif %}
        {% endif %}
      </div>
    </div>

    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    <div class="cv">
      {% for entry in site.data.cv %}
        <a class="anchor" id="{{ entry.title }}"></a>
        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">{{ entry.title }}</h3>
          <div>
            {% if entry.type == 'list' %}
              {% include cv/list.liquid %}
            {% elsif entry.type == 'map' %}
              {% include cv/map.liquid %}
            {% elsif entry.type == 'nested_list' %}
              {% include cv/nested_list.liquid %}
            {% elsif entry.type == 'time_table' %}
              {% include cv/time_table.liquid %}
            {% elsif entry.type == 'list_groups' %}
              {% include cv/list_groups.liquid %}
            {% else %}
              {{ entry.contents }}
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </article>
</div>
